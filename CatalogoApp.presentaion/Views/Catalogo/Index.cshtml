@model List<CatalogoApp.Domain.Models.Item>

@{
    ViewData["Title"] = "Catálogo";
}

<div class="catalogo-hero">
    <h1>🎮 Catálogo de Videojuegos</h1>
    <p class="hero-subtitle">Descubre, califica y comenta tus juegos favoritos</p>
</div>

<!-- Filtros por género -->
<div class="filtros-container">
    <a asp-action="Index" class="filtro-chip @(ViewBag.GeneroActual == null ? "activo" : "")">Todos</a>
    @foreach (var gen in (ViewBag.Generos as List<string>) ?? new List<string>())
    {
        <a asp-action="Index" asp-route-genero="@gen"
           class="filtro-chip @(ViewBag.GeneroActual == gen ? "activo" : "")">
            @gen
        </a>
    }
</div>

<!-- Grid de juegos -->
<div class="juegos-grid">
    @foreach (var item in Model)
    {
        <div class="juego-card">
            <div class="juego-card-header">
                <span class="juego-genero">@item.Genero</span>
            </div>
            <div class="juego-card-body">
                <h2 class="juego-titulo">@item.Titulo</h2>
                <div class="juego-meta">
                    <span>🎮 @item.Consola</span>
                    <span>📅 @item.Ano</span>
                </div>
                <p class="juego-desc">@item.Descripcion</p>
            </div>
            <div class="juego-card-footer">
                <a asp-action="Detalle" asp-route-id="@item.Id" class="btn-ver-detalle">Ver detalle →</a>
            </div>
        </div>
    }
</div>

<div class="agregar-container">
    <a asp-action="Agregar" class="btn-agregar">+ Agregar videojuego</a>
</div>
