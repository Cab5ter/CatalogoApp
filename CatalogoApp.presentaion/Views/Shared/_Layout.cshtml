<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - GameVault</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/gamevault.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/CatalogoApp.presentaion.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar-gv">
        <div class="navbar-gv-inner">
            <a class="navbar-brand-gv" asp-controller="Home" asp-action="Index">
                🎮 <span>GameVault</span>
            </a>
            <div class="navbar-links">
                <a class="nav-link-gv" asp-controller="Catalogo" asp-action="Index">Catálogo</a>
                <a class="nav-link-gv" asp-controller="Catalogo" asp-action="Agregar">+ Agregar</a>
            </div>
            <div class="navbar-auth">
                @{
                    var usuarioLogueado = Context.Session.GetString("Usuario");
                }
                @if (!string.IsNullOrEmpty(usuarioLogueado))
                {
                    <span class="usuario-badge">👤 @usuarioLogueado</span>
                    <a asp-controller="Auth" asp-action="Logout" class="btn-logout">Cerrar sesión</a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn-nav-login">Iniciar sesión</a>
                }
            </div>
        </div>
    </nav>
</header>

<div class="main-container">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="footer-gv">
    <div class="footer-inner">
        <span>🎮 GameVault &copy; 2026</span>
        <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
